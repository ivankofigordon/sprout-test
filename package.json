{
  "name": "sprout",
  "private": true,
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "prepare": "husky",
    "test": "run-s --continue-on-error test:root test:workspace",
    "test:root": "vitest run",
    "test:workspace": "turbo run test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.4",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "vitest": "5.1.0"
  }
}
